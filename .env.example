# Garmin Connect Developer Program (server-only; never expose these in VITE_* variables)
# You need Garmin approval and an application with this exact redirect URI.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Optional: use this when the public URL is different from the incoming request host.
# GARMIN_REDIRECT_URI=https://your-domain.example/api/garmin/callback

# AI provider (server-only)
OPENAI_API_KEY=
# Optional provider-compatible settings
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
